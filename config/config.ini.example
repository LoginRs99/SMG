[DEFAULT]
# SteamGifts Authentication
# Your SteamGifts.com PHPSESSID cookie value (Required)
cookie = your_phpsessid_here

# Giveaway Settings
# 0 = Skip pinned giveaways, 1 = Only enter pinned giveaways, 2 = Enter both
pinned_games = 0

# Gift type filter:
# Special Mode, All, Wishlist, Recommended, Copies, DLC, Group, New
gift_type = Special Mode

# Minimum points required to enter giveaways (Bot waits when below this threshold)
min_points = 70

# Comma-separated list of words to ignore in giveaway titles
ignored_words = 

# Bot Behavior & Limits
# Maximum giveaway entries per activity session
max_entries_per_session = 8

# Base sleep time between entries in seconds (subject to +-20% jitter)
base_sleep_time = 120

# Sleep time when no games found on page 1 (seconds)
sleep_time_no_games = 1800

# Sleep time when points are below min_points (seconds, e.g. 14400 = 4 hours)
sleep_time_no_points = 14400

# Minimum time between consecutive HTTP requests (seconds)
min_request_interval = 5.0

# Maximum consecutive network/scraping errors before 15-minute cooldown
max_consecutive_errors = 5

# Special Mode Settings
special_mode_cycle = true
special_mode_stages = Wishlist,Group,Recommended,DLC

# Discord Integration
# Webhook URL for notifications (leave empty to disable)
discord_webhook = 

# Daily report schedule time (HH:MM in configured timezone)
discord_notification_time = 23:00

# Opt-in @here mentions (true/false)
discord_mention_stats = false
discord_mention_wins = true
discord_mention_alerts = true

# Timezone & Logging
timezone = Europe/Budapest
log_level = INFO
log_to_file = true
log_to_console = true
